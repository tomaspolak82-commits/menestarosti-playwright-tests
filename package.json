{
  "name": "menestarosti-playwright-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Automated Playwright + TypeScript tests for menestarosti.cz",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:full": "playwright test --grep @full",
    "test:list": "playwright test --list",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "dotenv": "18.0.8",
    "eslint": "10.13.0",
    "eslint-plugin-playwright": "2.12.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
